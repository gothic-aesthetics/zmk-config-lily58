#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        katakana: katakana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(CAPSLOCK)>;
            label = "KATAKANA";
        };

        hiragana: hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(CAPSLOCK)>;
            label = "HIRAGANA";
        };

        japanese_switch: japanese_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "JAPANESE_SWITCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&gresc            &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                                         &kp N6  &kp N7         &kp N8      &kp N9   &kp N0         &kp EQUAL
&kp TAB           &kp Q   &kp W   &kp E         &kp R         &kp T                                          &kp Y   &kp U          &kp I       &kp O    &kp P          &kp MINUS
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F         &kp G                                          &kp H   &kp J          &kp K       &kp L    &kp SEMICOLON  &kp SINGLE_QUOTE
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V         &kp B   &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N   &kp M          &kp COMMA   &kp DOT  &kp SLASH      &kp BACKSLASH
                                  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &kp SPACE           &kp ENTER          &mo 2   &kp BACKSPACE  &kp DELETE
            >;
        };

        layer1 {
            bindings = <
&kp F1     &kp F2    &kp F3  &kp F4    &kp F5      &kp F6                                                &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2    &bt BT_SEL 3          &bt BT_SEL 4           &bt BT_CLR
&kp F7     &kp F8    &kp F9  &kp F10   &kp F11     &kp F12                                               &trans        &trans             &trans          &trans                &trans                 &trans
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT                                           &kp CARET     &kp AMPERSAND      &kp STAR        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &trans    &trans  &trans    &trans      &kp K_APPLICATION  &kp LEFT_BRACE    &kp RIGHT_BRACE  &trans        &trans             &trans          &trans                &trans                 &trans
                             &trans    &trans      &trans             &trans            &trans           &mo 3         &kp LC(BACKSPACE)  &kp LC(DELETE)
            >;
        };

        layer2 {
            bindings = <
&kp TILDE     &kp DOLLAR            &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_SLASH                                                    &kp LOCKING_NUM  &kp CAPSLOCK  &kp INSERT  &trans            &kp DEL            &kp PRINTSCREEN
&kp KP_EQUAL  &kp PERCENT           &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_ASTERISK                                                 &hiragana        &katakana     &trans      &trans            &kp PAGE_UP        &kp PAGE_DOWN
&kp C_VOL_UP  &kp C_BRIGHTNESS_INC  &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_PLUS                                                     &kp LEFT         &kp DOWN      &kp UP      &kp RIGHT         &kp HOME           &kp END
&kp C_VOL_DN  &kp C_BRIGHTNESS_DEC  &kp KP_N0  &kp KP_N0  &kp KP_DOT  &kp KP_MINUS     &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp PLUS         &kp MINUS     &kp EQUAL   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
                                               &trans     &trans      &mo 3            &trans                  &trans                 &trans           &trans        &trans
            >;
        };

        layer3 {
            bindings = <
&trans  &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&trans  &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&none   &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&none   &none  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none  &none
                      &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
