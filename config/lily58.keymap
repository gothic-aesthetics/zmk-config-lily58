#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&gresc            &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                                         &kp N6  &kp N7         &kp N8      &kp N9   &kp N0         &kp EQUAL
&kp TAB           &kp Q   &kp W   &kp E         &kp R         &kp T                                          &kp Y   &kp U          &kp I       &kp O    &kp P          &kp MINUS
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F         &kp G                                          &kp H   &kp J          &kp K       &kp L    &kp SEMICOLON  &kp SINGLE_QUOTE
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V         &kp B   &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N   &kp M          &kp COMMA   &kp DOT  &kp SLASH      &kp BACKSLASH
                                  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &kp SPACE           &kp ENTER          &mo 2   &kp BACKSPACE  &kp DELETE
            >;
        };

        layer1 {
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5      &kp F6                                                &trans     &trans             &trans          &trans                &trans                 &trans
&kp F7     &kp F8     &kp F9     &kp F10    &kp F11     &kp F12                                               &trans     &trans             &trans          &trans                &trans                 &trans
&kp GRAVE  &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR  &kp PERCENT                                           &kp CARET  &kp AMPERSAND      &kp STAR        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &kp K_APPLICATION  &kp LEFT_BRACE    &kp RIGHT_BRACE  &trans     &trans             &trans          &trans                &trans                 &trans
                                 &trans     &trans      &trans             &trans            &trans           &mo 3      &kp LC(BACKSPACE)  &kp LC(DELETE)
            >;
        };

        layer2 {
            bindings = <
&kp TILDE  &kp DOLLAR   &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_SLASH                                         &kp LOCKING_NUM  &kp CAPSLOCK  &kp INSERT  &trans            &trans             &kp PRINTSCREEN
&none      &kp PERCENT  &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_ASTERISK                                      &trans           &trans        &trans      &trans            &kp PAGE_UP        &kp PAGE_DOWN
&trans     &trans       &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_PLUS                                          &kp LEFT         &kp DOWN      &kp UP      &kp RIGHT         &kp HOME           &kp END
&trans     &trans       &kp KP_N0  &kp KP_N0  &kp KP_DOT  &kp KP_MINUS     &kp EQUAL    &kp RIGHT_PARENTHESIS  &kp PLUS         &kp MINUS     &kp EQUAL   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
                                   &trans     &trans      &mo 3            &trans       &trans                 &trans           &trans        &trans
            >;
        };

        layer3 {
            bindings = <
&none  &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&none  &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&none  &none  &none  &none   &none   &none                     &none   &none   &none   &none  &none  &none
&none  &none  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none  &none
                     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
